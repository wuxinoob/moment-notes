{
  "id": "custom.moment-notes",
  "name": "拾光便签",
  "version": "2.1.0",
  "api": 3,
  "entry": "main.js",
  "description": "基于 WebDAV 同步的高颜值便签插件，支持独立置顶悬浮窗与跨窗口双向同步",
  "contributes": {
    "views": [
      {
        "id": "main",
        "slot": "tool",
        "title": "拾光便签",
        "icon": "lucide:sticky-note"
      }
    ],
    "hotkeys": [
      {
        "key": "ctrl+alt+n",
        "action": "open"
      }
    ]
  },
  "permissions": [
    "rpc:storage",
    "rpc:bus",
    "win:manage"
  ]
}
