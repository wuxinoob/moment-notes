{
  "name": "moment-notes",
  "version": "2.1.0",
  "private": true,
  "description": "拾光便签：基于 Vue 3 + TypeScript + Vite 构建的高颜值 WebDAV 便签应用，支持纯前端与 Toolkit Tauri 插件运行。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:plugin": "vite build --config vite.config.plugin.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --fix",
    "lint:nocache": "eslint src --fix --no-cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
